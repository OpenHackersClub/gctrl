# Template for ~/.config/gctrl/env — the operator-owned env file consumed by
# scripts/install-launchd.sh. Copy to ~/.config/gctrl/env, fill in your
# values, then run scripts/install-launchd.sh to substitute them into the
# launchd plist and (re)load the daemon.
#
#   mkdir -p ~/.config/gctrl
#   cp scripts/launchd/example.env ~/.config/gctrl/env
#   chmod 600 ~/.config/gctrl/env
#   $EDITOR ~/.config/gctrl/env
#   ./scripts/install-launchd.sh
#
# Never commit your real values to git. ~/.config/gctrl/env lives outside
# the repo on purpose.

# ─── Driver secrets ─────────────────────────────────────────────────────────

# Telegram bot token from @BotFather. Required for /api/telegram/send.
TELEGRAM_BOT_TOKEN=

# Telegram chat id (numeric) the bot delivers to. Used by uber's profile.md
# `target_ref: tg:chat:env:TELEGRAM_PRIMARY_CHAT_ID` resolution.
TELEGRAM_PRIMARY_CHAT_ID=

# Discord webhook URL the deliverer POSTs to.
DISCORD_NOTIFY_WEBHOOK_URL=

# ─── Uebermensch ────────────────────────────────────────────────────────────

# Absolute path to the Obsidian vault. Required by every uber CLI command.
UBER_VAULT_DIR=

# ─── Scheduler exec target (operator opt-in) ────────────────────────────────
#
# When enabled, the kernel scheduler can fire `target_kind: exec` schedule
# rows — spawning child processes on cron. This is what lets `uber schedule
# sync` register the daily brief job. OFF by default; turning it on grants
# anyone who can POST to localhost:4318 the ability to run any program in
# the allowlist below.

# 1 = enabled, 0 = disabled.
GCTRL_SCHEDULER_EXEC_ENABLED=0

# Colon-separated absolute paths. Only argv[0] values exactly matching one of
# these are accepted. Empty = no exec rows accepted (the runner refuses).
# Example for uber: /opt/homebrew/bin/node
GCTRL_SCHEDULER_EXEC_ALLOWED_PROGRAMS=
