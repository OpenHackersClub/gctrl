{
  "name": "gctrl-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "description": "Electron-based macOS distribution for gctrl. Bundles the Rust kernel as a sidecar.",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "biome lint src/"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^34.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
