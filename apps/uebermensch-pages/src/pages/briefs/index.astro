---
import Shell from "../../layouts/Shell.astro"
import { renderIndex } from "../../lib/pages.ts"

const result = await renderIndex(Astro.locals.runtime.env.VAULT, "briefs/", "Briefs", "/briefs/")
Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300")
---
<Shell title={result.title}>
  <Fragment set:html={result.bodyHtml} />
</Shell>
